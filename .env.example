# SecretLeak example environment file.
# Copy to ".env" and adjust if needed. NEVER put real credentials in this file.

# Where SecretLeak stores its local data (SQLite DB + generated HMAC key).
# Leave empty to use the default: <project>/backend/data
SECRELEAK_DATA_DIR=

# Override the location of the HMAC fingerprint key file.
# Leave empty to use the default: <data dir>/.hmac_key
SECRELEAK_HMAC_KEY_FILE=

# Allowed browser origins for the API (comma separated, no wildcard).
# Default matches the Vite dev server.
SECRELEAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted HTTP request body size in megabytes (uploads included).
SECRELEAK_MAX_REQUEST_MB=25
